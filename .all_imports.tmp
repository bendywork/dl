word_file_path = './datas/cut_words_of_in_the_name_of_people.txt'

model_file_path1 = './datas/gensim_word2vec1.w2v'

model_file_path2 = './datas/gensim_word2vec2.bin'

model_file_path3 = './datas/gensim_word2vec3_{}.npy'
# 人民的名义 小说分词

