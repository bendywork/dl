# import modules & set up logging

import logging

import os



import numpy as np



import gensim

from gensim.models import word2vec



import jieba.analyse

import jieba
# set up logging

logging.basicConfig(format='%(asctime)s : %(levelname)s : %(message)s', level=logging.INFO)
